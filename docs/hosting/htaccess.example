# ADelier Commerce — Apache/LiteSpeed rules for VH.PL. NOT INSTALLED, NOT TESTED.
#
# Deployment type is not confirmed yet:
# - Node.js app (cPanel "Setup Node.js App"): Next.js serves its own redirects
#   and headers. Only section 1 (HTTPS, www) and section 5 (body limit) are
#   still needed in front of the app. Sections 2-4 would duplicate the app.
# - Static files only: next.config.mjs and proxy.ts DO NOT run, so sections
#   1-4 are required, and /api/contact does not exist at all.
# Upload as `.htaccess`, then verify each rule with `curl -I`.
#
# Requires mod_rewrite and mod_headers (check with VH.PL; LiteSpeed reads them).

RewriteEngine On

# 1. HTTPS, and www -> non-www, in one 301 hop.
RewriteCond %{HTTPS} off [OR]
RewriteCond %{HTTP_HOST} ^www\. [NC]
RewriteRule ^ https://deliercommerce.com%{REQUEST_URI} [L,R=301]

# 2. Language root: / -> /en/ (the app negotiates Accept-Language; static
#    hosting cannot, so English is the default).
RewriteRule ^$ /en/ [L,R=302]

# 3. Retired routes (mirror of next.config.mjs redirects()).
RewriteRule ^(en|pl|de)/(amazon-ppc-management|amazon-market-validation-audits|services)/?$ /$1/brands [L,R=301]
RewriteRule ^(amazon-ppc-management|amazon-market-validation-audits|services)/?$ /en/brands [L,R=301]

# 4. Security headers (mirror of next.config.mjs headers()).
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Strict-Transport-Security "max-age=63072000"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
  Header always set Content-Security-Policy-Report-Only "default-src 'self'; img-src 'self' data: https:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; connect-src 'self'"
</IfModule>

# 5. Request size limit for the contact endpoint, enforced before the app
#    (the app also rejects anything over 16 KB). <If> needs Apache 2.4; confirm
#    LiteSpeed on VH.PL honours it, otherwise ask VH.PL for the equivalent.
<If "%{REQUEST_URI} =~ m#^/api/contact#">
  LimitRequestBody 16384
</If>

# NOTE: a static export cannot run app/api/contact. A form endpoint for that
# setup (e.g. PHP with authenticated SMTP) does not exist and must not be
# referenced until it is built and tested.
