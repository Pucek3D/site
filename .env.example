# Public site URL, used for canonical links, hreflang, sitemap and Open Graph.
NEXT_PUBLIC_SITE_URL=https://www.your-domain.com

# Shown in the footer and contact page. Replace before launch.
NEXT_PUBLIC_CONTACT_EMAIL=hello@your-domain.com
NEXT_PUBLIC_LINKEDIN_URL=https://www.linkedin.com/company/your-company

# Contact form delivery (server-side only, never exposed to the browser).
# Set CONTACT_WEBHOOK_URL to any endpoint that accepts a JSON POST
# (e.g. a CRM intake, Zapier/Make hook, or your own mail service).
# When unset, inquiries are validated and logged on the server only, and the
# visitor sees the failure state rather than a false confirmation.
CONTACT_WEBHOOK_URL=
CONTACT_WEBHOOK_SECRET=
CONTACT_TO_EMAIL=
