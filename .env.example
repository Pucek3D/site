# Canonical site URL, used for canonical links, hreflang, sitemap and Open Graph.
# Non-www is canonical. The www -> non-www redirect belongs in the hosting config.
NEXT_PUBLIC_SITE_URL=https://adeliercommerce.com

# SEO. Production must index: leave SEO_NOINDEX unset/false there. Set true on
# previews (VERCEL_ENV=preview is treated the same) to send X-Robots-Tag noindex.
SEO_NOINDEX=false
# Search engine ownership tokens. Leave empty until the real values exist.
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=

# Shown in the footer and contact page.
NEXT_PUBLIC_CONTACT_EMAIL=contact@adeliercommerce.com
NEXT_PUBLIC_LINKEDIN_URL=

# Legal pages (/privacy, /legal) show the owner's residential address.
# They return 404 in production until the owner has reviewed the text and the
# address and explicitly approves publication by setting this to true BEFORE
# the production build. Leaving it false is a RELEASE BLOCKER: the contact form
# links to the Privacy Notice, which must not be unavailable.
# `pnpm preflight` reports this. Never flip it without the owner's approval.
# This applies in EVERY environment, development and previews included.
LEGAL_PUBLISH_APPROVED=false

# Private review of the legal pages before approval: set a random secret of at
# least 24 characters (e.g. `openssl rand -hex 24`) and open
# /en/privacy?review=<token>. Without it, unapproved legal pages are 404 for all.
# Never share the URL publicly; remove the token after approval.
LEGAL_REVIEW_TOKEN=

# Contact form delivery (server-side only, never exposed to the browser).
# Inquiries are delivered to CONTACT_TO_EMAIL. When no delivery method is
# configured, the visitor sees the failure state, never a false confirmation.
CONTACT_TO_EMAIL=contact@adeliercommerce.com

# Origins allowed to submit the form, besides https://adeliercommerce.com and its
# www variant (comma-separated full origins). The request's own Host is NOT trusted.
CONTACT_ALLOWED_ORIGINS=

# Header carrying the visitor IP, set ONLY if the hosting proxy writes it itself
# (confirm with VH.PL, e.g. x-real-ip). Unset = no IP is trusted; rate limiting
# uses the submitted email address plus a site-wide brake instead.
CONTACT_TRUSTED_IP_HEADER=

# Option A (preferred when Node.js runs on the host): authenticated SMTP via the
# VH.PL mailbox. Used when SMTP_HOST, SMTP_USER, SMTP_PASS and SMTP_FROM are all
# set. SMTP_FROM must be the authenticated mailbox; the visitor becomes Reply-To.
# Never commit real values; set them in the hosting panel only.
SMTP_HOST=
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Option B: webhook (any endpoint accepting a JSON POST). Used only if SMTP is
# not configured. A webhook accepting the request is not proof of mailbox delivery.
CONTACT_WEBHOOK_URL=
CONTACT_WEBHOOK_SECRET=

# Analytics: disabled by default. No provider is installed or loaded.
# Before enabling a (preferably cookieless) provider, update the privacy notice
# in all three languages.
NEXT_PUBLIC_ANALYTICS_ENABLED=false
