# Production build configuration (committed; contains no secrets).
# Read by `next build` / `next start` and by `pnpm preflight`.
#
# Owner approval: the website owner explicitly approved publishing the Legal
# Notice and Privacy Notice, including her residential address, before a
# separate legal review. This is publication approval, NOT confirmation that a
# lawyer has reviewed the documents.
LEGAL_PUBLISH_APPROVED=true

# Owner-confirmed canonical domain (SEO kit). Production must index.
NEXT_PUBLIC_SITE_URL=https://adeliercommerce.com
SEO_NOINDEX=false
